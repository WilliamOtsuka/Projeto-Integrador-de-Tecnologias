{
  "name": "ong-sem-fome-site",
  "version": "1.0.0",
  "description": "Site ONG SEM FOME - servidor Express para servir arquivos estáticos",
  "main": "server.js",
  "scripts": {
    "start": "node scripts/apply-schema.js && node server.js",
    "dev": "nodemon --exec \"node scripts/apply-schema.js && node src/server.js\"",
    "db:seed": "node scripts/seed.js",
    "db:schema": "node scripts/apply-schema.js",
    "db:migrate:solicitacoes": "node scripts/migrate-solicitacoes-fks.js"
  },
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
  "dotenv": "^16.4.5",
  "express": "^4.18.2",
  "mysql2": "^3.11.3",
  "express-session": "^1.18.2"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
}
